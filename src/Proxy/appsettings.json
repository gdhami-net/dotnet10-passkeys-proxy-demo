{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5100",
  "ReverseProxy": {
    "Routes": {
      "app": {
        "ClusterId": "app",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "app": {
        "Destinations": {
          "d1": { "Address": "http://127.0.0.1:5292/" }
        }
      }
    }
  }
}
